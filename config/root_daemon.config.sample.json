{
  "managed_users": [
    { "mac_user_account": "kiddo", "child_name": "kiddo", "topic_prefix": "screen/kiddo" }
  ],
  "device_id": "mac-mini",
  "device_friendly_name": "",
  "mqtt_host": "mqtt.home.local",
  "mqtt_port": 1883,
  "mqtt_username": "",
  "mqtt_password": "",
  "mqtt_tls": false,
  "sample_interval_seconds": 15,

  "fail_mode": "safe",
  "rapid_relogin_shutdown_enabled": true,
  "rapid_relogin_window_seconds": 60,
  "rapid_relogin_max_attempts": 4,
  "rapid_relogin_warn_attempt": 3,
  "rapid_relogin_warn_voice": true,

  "root_daemon_fail_mode": "safe",
  "root_daemon_fail_grace_minutes": 120,
  "root_daemon_rapid_relogin_max_attempts": 4,
  "root_daemon_rapid_relogin_warn_attempt": 3,
  "root_daemon_dry_run": false,

  "blocked_check_seconds": 1.0,
  "idle_timeout_seconds": 180,
  "enforcement_mode": "lock",
  "logout_method": "osascript",
  "offline_grace_period_seconds": 180,
  "state_path": "~/Library/Application Support/ha-screen-agent/state.json",
  "log_file": "~/Library/Logs/ha-screen-agent/agent.out.log",
  "err_log_file": "~/Library/Logs/ha-screen-agent/agent.err.log",
  "debug_mqtt": false,
  "track_active_app": false
}
