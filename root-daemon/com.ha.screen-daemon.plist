<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    LaunchDaemon (not LaunchAgent) — runs as root, system-wide, independent
    of any single user's login session. Installed to
    /Library/LaunchDaemons/com.ha.screen-daemon.plist (root:wheel owned,
    permissions 644), then loaded with:

        sudo launchctl bootstrap system /Library/LaunchDaemons/com.ha.screen-daemon.plist

    Unlike the per-user LaunchAgent this replaces, there is no per-account
    bootstrap step and nothing tied to logout/login — this starts at boot
    and runs continuously, which is the whole point: it removes the
    "reboot needed between account switches" problem at the source.

    This file is a reference copy — scripts/install_root_daemon.sh
    generates and installs this same content itself, so editing this file
    alone does not change an installed daemon's behavior.
    -->
    <key>Label</key>
    <string>com.ha.screen-daemon</string>

    <!--
    Uses the production venv's python3, NOT plain /usr/bin/python3 —
    confirmed on real hardware that plain /usr/bin/python3 as root can't
    see paho-mqtt (it's installed under a regular user's site-packages,
    invisible to root). This venv already has paho-mqtt, pyobjc/Quartz,
    and SystemConfiguration all confirmed working as root.

    Both scripts install into the SAME shared directory
    (/Library/Application Support/ha-screen-agent) — one venv, one
    config.json, used by the old per-user agent and this daemon alike.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/ha-screen-agent/venv/bin/python3</string>
        <string>/Library/Application Support/ha-screen-agent/root_daemon.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>UserName</key>
    <string>root</string>

    <key>StandardOutPath</key>
    <string>/var/log/ha-screen-daemon.out.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/ha-screen-daemon.err.log</string>
</dict>
</plist>
